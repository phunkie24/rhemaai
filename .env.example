# =====================================================
# RhemaAI Solutions Ltd - Docker Compose environment
# Copy to .env and fill in production values:
#   cp .env.example .env
# =====================================================

# Required in production. Use your live domain after DNS is pointed at the VPS.
FRONTEND_URL=https://rhemaaisolutions.tech

# Required in production for protected admin access to GET /api/contact.
# Generate a long random value and keep it private.
CONTACT_ADMIN_KEY=replace_with_a_long_random_secret

# Hostinger mailbox credentials for website notifications.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=info@rhemaaisolutions.tech
EMAIL_PASS=your_hostinger_mailbox_password
NOTIFY_EMAIL=
# Optional exact sender addresses or domains to block, comma separated.
FORM_BLOCKED_SENDERS=
